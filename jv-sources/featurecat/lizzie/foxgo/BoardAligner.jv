package featurecat.lizzie.foxgo;

import featurecat.lizzie.Lizzie;
import featurecat.lizzie.util.Utils;
import java.awt.*;
import java.awt.event.*;
import java.awt.image.BufferedImage;
import javax.swing.*;
import javax.swing.border.EmptyBorder;

/**
 * Provides a crosshair magnifier overlay for visually calibrating board corner positions. Both
 * "Pick Top-Left" and "Pick Bottom-Right" open a floating magnifier window.
 */
public class BoardAligner extends JDialog {
  private static final int MAG_SIZE = 160; // magnified area size in pixels
  private static final int GRID = 11; // 11x11 pixel grid
  private static final double SCALE = MAG_SIZE / (double) GRID; // ~14.545
  private static final int WIN_W = MAG_SIZE + 40;
  private static final int WIN_H = MAG_SIZE + 60;

  private JTextField topXField;
  private JTextField topYField;
  private JTextField bottomXField;
  private JTextField bottomYField;
  private JLabel statusLabel;
  private JButton startBtn;
  private JButton stopBtn;

  private final FoxGoBridge bridge;

  // ======================== Constructor ========================

  public BoardAligner(FoxGoBridge bridge) {
    super(Lizzie.frame, "棋盘校准", false);
    this.bridge = bridge;
    initUI();
    loadConfig();
    pack();
    setLocationRelativeTo(Lizzie.frame);
    setResizable(false);
  }

  // ======================== UI Setup ========================

  private void initUI() {
    JPanel mainPanel = new JPanel(new BorderLayout(10, 10));
    mainPanel.setBorder(new EmptyBorder(15, 15, 15, 15));

    // Header area
    JPanel header = new JPanel(new BorderLayout());
    JLabel title = new JLabel("Fox Go AI 校准");
    title.setFont(new Font("SansSerif", Font.BOLD, 16));
    header.add(title, BorderLayout.WEST);

    statusLabel = new JLabel("等待校准");
    statusLabel.setFont(new Font("SansSerif", Font.PLAIN, 12));
    statusLabel.setForeground(Color.GRAY);
    header.add(statusLabel, BorderLayout.EAST);
    mainPanel.add(header, BorderLayout.NORTH);

    // Form area
    JPanel form = new JPanel(new GridBagLayout());
    GridBagConstraints gbc = new GridBagConstraints();
    gbc.fill = GridBagConstraints.HORIZONTAL;
    gbc.insets = new Insets(5, 5, 5, 5);

    // Instructions
    gbc.gridx = 0;
    gbc.gridy = 0;
    gbc.gridwidth = 4;
    JLabel instructions =
        new JLabel(
            "<html>在 Fox Go 棋盘上，请先校准两个角点。<br>"
                + "点击\u201C选取左上角\u201D或\u201C选取右下角\u201D按钮打开放大镜，再点击选择对应的坐标点。<br>"
                + "按 ESC 取消选择</html>");
    instructions.setFont(new Font("SansSerif", Font.PLAIN, 12));
    form.add(instructions, gbc);

    gbc.gridwidth = 1;

    // Top-Left row
    gbc.gridy = 1;
    gbc.gridx = 0;
    form.add(new JLabel("左上角 X:"), gbc);
    gbc.gridx = 1;
    topXField = new JTextField(6);
    form.add(topXField, gbc);
    gbc.gridx = 2;
    form.add(new JLabel("Y:"), gbc);
    gbc.gridx = 3;
    topYField = new JTextField(6);
    form.add(topYField, gbc);

    // Bottom-Right row
    gbc.gridy = 2;
    gbc.gridx = 0;
    form.add(new JLabel("右下角 X:"), gbc);
    gbc.gridx = 1;
    bottomXField = new JTextField(6);
    form.add(bottomXField, gbc);
    gbc.gridx = 2;
    form.add(new JLabel("Y:"), gbc);
    gbc.gridx = 3;
    bottomYField = new JTextField(6);
    form.add(bottomYField, gbc);

    // Buttons row
    gbc.gridy = 3;
    gbc.gridx = 0;
    gbc.gridwidth = 2;
    JButton pickTopBtn = new JButton("选取左上角");
    pickTopBtn.addActionListener(e -> pickPosition(true));
    form.add(pickTopBtn, gbc);

    gbc.gridx = 2;
    gbc.gridwidth = 2;
    JButton pickBottomBtn = new JButton("选取右下角");
    pickBottomBtn.addActionListener(e -> pickPosition(false));
    form.add(pickBottomBtn, gbc);

    gbc.gridy = 4;
    gbc.gridx = 0;
    gbc.gridwidth = 4;
    JButton showBtn = new JButton("显示棋盘轮廓");
    showBtn.addActionListener(e -> showBoardContour());
    form.add(showBtn, gbc);

    // 微调按钮行
    gbc.gridy = 5;
    gbc.gridwidth = 1;
    JButton upBtn = new JButton("上移");
    upBtn.setFont(new Font("SansSerif", Font.PLAIN, 11));
    upBtn.addActionListener(e -> {
      bridge.getOverlayWindow().adjustOffset(0, -2);
      updateStatus("上移 2px", new Color(0, 128, 0));
    });
    form.add(upBtn, gbc);

    gbc.gridx = 1;
    JButton downBtn = new JButton("下移");
    downBtn.setFont(new Font("SansSerif", Font.PLAIN, 11));
    downBtn.addActionListener(e -> {
      bridge.getOverlayWindow().adjustOffset(0, 2);
      updateStatus("下移 2px", new Color(0, 128, 0));
    });
    form.add(downBtn, gbc);

    gbc.gridx = 2;
    JButton leftBtn = new JButton("左移");
    leftBtn.setFont(new Font("SansSerif", Font.PLAIN, 11));
    leftBtn.addActionListener(e -> {
      bridge.getOverlayWindow().adjustOffset(-2, 0);
      updateStatus("左移 2px", new Color(0, 128, 0));
    });
    form.add(leftBtn, gbc);

    gbc.gridx = 3;
    JButton rightBtn = new JButton("右移");
    rightBtn.setFont(new Font("SansSerif", Font.PLAIN, 11));
    rightBtn.addActionListener(e -> {
      bridge.getOverlayWindow().adjustOffset(2, 0);
      updateStatus("右移 2px", new Color(0, 128, 0));
    });
    form.add(rightBtn, gbc);

    // 第6行：重置偏移、保存偏移
    gbc.gridy = 6;
    gbc.gridwidth = 2;
    gbc.gridx = 0;
    JButton resetOffsetBtn = new JButton("重置偏移");
    resetOffsetBtn.setFont(new Font("SansSerif", Font.PLAIN, 11));
    resetOffsetBtn.addActionListener(e -> {
      bridge.getOverlayWindow().resetOffset();
      updateStatus("偏移已重置", new Color(0, 128, 0));
    });
    form.add(resetOffsetBtn, gbc);

    gbc.gridx = 2;
    JButton saveOffsetBtn = new JButton("保存偏移");
    saveOffsetBtn.setFont(new Font("SansSerif", Font.PLAIN, 11));
    saveOffsetBtn.addActionListener(e -> saveOffsetConfig());
    form.add(saveOffsetBtn, gbc);

    // 第7行：隐藏轮廓
    gbc.gridy = 7;
    gbc.gridwidth = 4;
    gbc.gridx = 0;
    JButton hideBtn = new JButton("隐藏轮廓");
    hideBtn.addActionListener(e -> bridge.getOverlayWindow().hideOverlay());
    form.add(hideBtn, gbc);

    // 第8行：开始同步、停止同步
    gbc.gridy = 8;
    gbc.gridwidth = 2;
    gbc.gridx = 0;
    startBtn = new JButton("开始同步");
    startBtn.addActionListener(e -> startSync());
    form.add(startBtn, gbc);

    gbc.gridx = 2;
    stopBtn = new JButton("停止同步");
    stopBtn.addActionListener(e -> stopSync());
    stopBtn.setEnabled(false);
    form.add(stopBtn, gbc);

    // 第9行：保存校准、关闭
    gbc.gridy = 9;
    gbc.gridwidth = 2;
    gbc.gridx = 0;
    JButton saveBtn = new JButton("保存校准");
    saveBtn.addActionListener(e -> saveConfig());
    form.add(saveBtn, gbc);

    gbc.gridx = 2;
    JButton closeBtn = new JButton("关闭");
    closeBtn.addActionListener(e -> dispose());
    form.add(closeBtn, gbc);

    mainPanel.add(form, BorderLayout.CENTER);
    add(mainPanel);
  }

  // ======================== Magnifier pick ========================

  /**
   * Opens a full-screen transparent pick window so the user can click anywhere on the screen
   * (including the Fox Go board) without being blocked by the modal dialog. A magnifier HUD
   * follows the cursor showing an 11x11 zoomed pixel grid. Click to confirm, ESC to cancel.
   *
   * <p>Fix summary vs. old implementation:
   * <ul>
   *   <li>The parent modal dialog is hidden while picking so AWT events reach the pick window.
   *   <li>A full-screen transparent JWindow captures every mouse event directly — no AWTEventListener needed.
   *   <li>The magnifier JWindow is a separate always-on-top child so it renders on top of the pick glass.
   *   <li>Keyboard focus is explicitly requested on the full-screen window so ESC works reliably.
   *   <li>Coordinates come from MouseEvent directly (not a frozen lastCapturedPos), so they are always accurate.
   * </ul>
   *
   * @param isLeft true to fill the top-left fields; false for bottom-right
   */
  private void pickPosition(boolean isLeft) {
    Robot robot;
    try {
      robot = new Robot();
    } catch (AWTException ex) {
      ex.printStackTrace();
      Utils.showMessageDialog(this, "无法创建屏幕抓取对象。");
      return;
    }

    Dimension screen = Toolkit.getDefaultToolkit().getScreenSize();
    Rectangle screenRect = new Rectangle(screen);

    // ── Magnifier popup ──────────────────────────────────────────────────────
    JWindow magWindow = new JWindow();
    magWindow.setAlwaysOnTop(true);
    magWindow.setSize(WIN_W, WIN_H);
    magWindow.setBackground(new Color(0, 0, 0, 0));

    JLabel infoLabel = new JLabel("<html>正在初始化...</html>", SwingConstants.CENTER);
    infoLabel.setForeground(new Color(200, 255, 200));
    infoLabel.setFont(new Font("Monospaced", Font.PLAIN, 11));
    infoLabel.setBackground(new Color(30, 30, 30, 220));
    infoLabel.setOpaque(true);
    infoLabel.setPreferredSize(new Dimension(MAG_SIZE + 20, 40)); // 足够显示两行文字

    JLabel hintLabel = new JLabel("左键 = 确认  |  ESC = 取消", SwingConstants.CENTER);
    hintLabel.setForeground(Color.LIGHT_GRAY);
    hintLabel.setFont(new Font("SansSerif", Font.PLAIN, 10));
    hintLabel.setBackground(new Color(30, 30, 30, 220));
    hintLabel.setOpaque(true);
    hintLabel.setPreferredSize(new Dimension(MAG_SIZE + 20, 25));

    int[] pixelBuffer = new int[GRID * GRID];

    JPanel magPanel =
        new JPanel() {
          @Override
          protected void paintComponent(Graphics g) {
            // 圆形裁剪：只显示在圆形区域内
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setClip(new java.awt.geom.Ellipse2D.Double(0, 0, MAG_SIZE, MAG_SIZE));

            // Draw zoomed pixels
            for (int row = 0; row < GRID; row++) {
              for (int col = 0; col < GRID; col++) {
                int argb = pixelBuffer[row * GRID + col];
                if ((argb & 0xFF000000) != 0) {
                  g2.setColor(new Color(argb, false));
                  g2.fillRect(
                      (int) (col * SCALE),
                      (int) (row * SCALE),
                      (int) Math.ceil(SCALE),
                      (int) Math.ceil(SCALE));
                }
              }
            }
            // Grid lines (only inside circle)
            g2.setColor(new Color(80, 80, 80, 180));
            g2.setStroke(new BasicStroke(0.5f));
            for (int i = 0; i <= GRID; i++) {
              int pos = (int) (i * SCALE);
              g2.drawLine(pos, 0, pos, MAG_SIZE);
              g2.drawLine(0, pos, MAG_SIZE, pos);
            }
            // Crosshair (clipped to circle)
            int cx = MAG_SIZE / 2;
            int cy = MAG_SIZE / 2;
            g2.setColor(Color.RED);
            g2.setStroke(new BasicStroke(2f));
            g2.drawLine(cx - 10, cy, cx + 10, cy);
            g2.drawLine(cx, cy - 10, cx, cy + 10);
            g2.dispose();
          }

          @Override
          public boolean contains(int x, int y) {
            // 圆形命中检测
            int cx = MAG_SIZE / 2;
            int cy = MAG_SIZE / 2;
            int r = MAG_SIZE / 2;
            return (x - cx) * (x - cx) + (y - cy) * (y - cy) <= r * r;
          }
        };
    magPanel.setPreferredSize(new Dimension(MAG_SIZE, MAG_SIZE));
    magPanel.setBackground(new Color(0, 0, 0, 0)); // 透明背景，圆形外不显示
    // 圆形边框（用空边框占位，实际边框由paintComponent的clip实现）
    magPanel.setBorder(BorderFactory.createEmptyBorder());

    magWindow.setLayout(new BorderLayout(0, 0));
    magWindow.add(infoLabel, BorderLayout.NORTH);
    magWindow.add(magPanel, BorderLayout.CENTER);
    magWindow.add(hintLabel, BorderLayout.SOUTH);
    magWindow.pack();

    // ── Full-screen transparent glass pane that captures all mouse events ────
    // Using a JWindow here (not a JDialog) avoids modal-blocking issues.
    JWindow glassPane = new JWindow();
    glassPane.setSize(screen.width, screen.height);
    glassPane.setLocation(0, 0);
    // Fully transparent but still receives mouse events
    glassPane.setBackground(new Color(0, 0, 0, 1));
    glassPane.setAlwaysOnTop(true);

    // Shared mutable cursor position (screen coords under the crosshair)
    int[] cursorPos = {0, 0};

    // ── Timer: refresh magnifier every 80ms ──────────────────────────────────
    Timer refreshTimer =
        new Timer(
            80,
            e -> {
              Point mp = MouseInfo.getPointerInfo().getLocation();
              cursorPos[0] = mp.x;
              cursorPos[1] = mp.y;

              // Position magnifier 20px to the right/below cursor; flip if near edge
              int mwX = mp.x + 20;
              int mwY = mp.y + 20;
              if (mwX + magWindow.getWidth() > screen.width) {
                mwX = mp.x - magWindow.getWidth() - 10;
              }
              if (mwY + magWindow.getHeight() > screen.height) {
                mwY = mp.y - magWindow.getHeight() - 10;
              }
              magWindow.setLocation(Math.max(0, mwX), Math.max(0, mwY));

              // Always show current coordinates (even at screen edges)
              // For pixel capture, we need margin of GRID/2 = 5 pixels from edges
              int half = GRID / 2; // 5
              int captX = mp.x - half;
              int captY = mp.y - half;
              boolean canCapture = captX >= 0 && captY >= 0
                  && captX + GRID <= screen.width
                  && captY + GRID <= screen.height;

              if (canCapture) {
                try {
                  BufferedImage capture =
                      robot.createScreenCapture(new Rectangle(captX, captY, GRID, GRID));
                  for (int r = 0; r < GRID; r++) {
                    for (int c = 0; c < GRID; c++) {
                      pixelBuffer[r * GRID + c] = capture.getRGB(c, r);
                    }
                  }
                  int centerArgb = capture.getRGB(half, half);
                  int rv = (centerArgb >> 16) & 0xFF;
                  int gv = (centerArgb >> 8) & 0xFF;
                  int bv = centerArgb & 0xFF;
                  infoLabel.setText(
                      String.format("<html>RGB(%d,%d,%d)<br>坐标: (%d, %d)</html>", rv, gv, bv, mp.x, mp.y));
                } catch (Exception ex) {
                  // 截取失败，显示坐标但无RGB
                  infoLabel.setText(String.format("<html>坐标: (%d, %d)<br>[边缘区域]</html>", mp.x, mp.y));
                }
              } else {
                // 无法截取像素（靠近边缘），仍然显示坐标
                infoLabel.setText(String.format("<html>坐标: (%d, %d)<br>[靠近边缘]</html>", mp.x, mp.y));
                // 清除像素缓冲区为黑色
                for (int i = 0; i < pixelBuffer.length; i++) pixelBuffer[i] = 0xFF000000;
              }
              magPanel.repaint();
            });

    // ── Helper to commit the picked position and clean up ────────────────────
    Runnable commit =
        () -> {
          refreshTimer.stop();
          glassPane.dispose();
          magWindow.dispose();
          int sx = cursorPos[0];
          int sy = cursorPos[1];
          if (isLeft) {
            topXField.setText(String.valueOf(sx));
            topYField.setText(String.valueOf(sy));
          } else {
            bottomXField.setText(String.valueOf(sx));
            bottomYField.setText(String.valueOf(sy));
          }
          updateStatus(String.format("%s已选取: (%d, %d)",
              isLeft ? "左上角" : "右下角", sx, sy), new Color(0, 128, 0));
          // Restore the dialog
          BoardAligner.this.setVisible(true);
          BoardAligner.this.toFront();
        };

    Runnable cancel =
        () -> {
          refreshTimer.stop();
          glassPane.dispose();
          magWindow.dispose();
          updateStatus("已取消", Color.GRAY);
          BoardAligner.this.setVisible(true);
          BoardAligner.this.toFront();
        };

    // ── Mouse listener on the glass pane (captures the actual click) ─────────
    glassPane.addMouseListener(
        new MouseAdapter() {
          @Override
          public void mousePressed(MouseEvent evt) {
            if (evt.getButton() == MouseEvent.BUTTON1) {
              // Update position from the actual MouseEvent for maximum accuracy
              cursorPos[0] = evt.getXOnScreen();
              cursorPos[1] = evt.getYOnScreen();
              SwingUtilities.invokeLater(commit);
            }
          }
        });

    // ── Key listener on the glass pane for ESC ───────────────────────────────
    glassPane.setFocusable(true);
    glassPane.addKeyListener(
        new KeyAdapter() {
          @Override
          public void keyPressed(KeyEvent e) {
            if (e.getKeyCode() == KeyEvent.VK_ESCAPE) {
              SwingUtilities.invokeLater(cancel);
            }
          }
        });

    // ── Crosshair cursor on the glass pane ───────────────────────────────────
    glassPane.setCursor(Cursor.getPredefinedCursor(Cursor.CROSSHAIR_CURSOR));

    // ── Show everything ───────────────────────────────────────────────────────
    // Hide the modal dialog first so it stops blocking AWT events
    BoardAligner.this.setVisible(false);

    magWindow.setVisible(true);
    glassPane.setVisible(true);
    glassPane.requestFocusInWindow();
    refreshTimer.start();
  }

  // ======================== Board contour ========================

  private void showBoardContour() {
    String tx = topXField.getText().trim();
    String ty = topYField.getText().trim();
    String bx = bottomXField.getText().trim();
    String by = bottomYField.getText().trim();

    if (tx.isEmpty() || ty.isEmpty() || bx.isEmpty() || by.isEmpty()) {
      Utils.showMessageDialog(this, "请先校准坐标。");
      return;
    }

    try {
      int topX = Integer.parseInt(tx);
      int topY = Integer.parseInt(ty);
      int botX = Integer.parseInt(bx);
      int botY = Integer.parseInt(by);

      bridge.applyCalibration(topX, topY, botX, botY);
      OverlayWindow overlay = bridge.getOverlayWindow();
      overlay.alignToBoard(topX, topY, botX, botY);
      overlay.showOverlay();
      updateStatus("轮廓已显示", new Color(0, 128, 0));
    } catch (NumberFormatException e) {
      Utils.showMessageDialog(this, "坐标格式无效");
    }
  }

  // ======================== Start / Stop sync ========================

  private void startSync() {
    if (!bridge.getStoneDetector().isCalibrated()) {
      Utils.showMessageDialog(this, "请先校准好位置。");
      return;
    }
    bridge.start();
    startBtn.setEnabled(false);
    stopBtn.setEnabled(true);
    updateStatus("同步中...", new Color(0, 128, 0));
  }

  private void stopSync() {
    bridge.stop();
    startBtn.setEnabled(true);
    stopBtn.setEnabled(false);
    updateStatus("已停止", Color.GRAY);
  }

  // ======================== Config persistence ========================

  private void saveConfig() {
    try {
      Lizzie.config.leelazConfig.put("foxgo-top-x", Integer.parseInt(topXField.getText().trim()));
      Lizzie.config.leelazConfig.put("foxgo-top-y", Integer.parseInt(topYField.getText().trim()));
      Lizzie.config.leelazConfig.put(
          "foxgo-bottom-x", Integer.parseInt(bottomXField.getText().trim()));
      Lizzie.config.leelazConfig.put(
          "foxgo-bottom-y", Integer.parseInt(bottomYField.getText().trim()));
      // 同时保存偏移
      Lizzie.config.leelazConfig.put("foxgo-h-offset", bridge.getOverlayWindow().getHOffset());
      Lizzie.config.leelazConfig.put("foxgo-v-offset", bridge.getOverlayWindow().getVOffset());
      Lizzie.config.save();
      updateStatus("配置已保存", new Color(0, 128, 0));
    } catch (NumberFormatException e) {
      Utils.showMessageDialog(this, "坐标格式无效");
    } catch (Exception e) {
      updateStatus("保存失败", Color.RED);
    }
  }

  private void saveOffsetConfig() {
    try {
      Lizzie.config.leelazConfig.put("foxgo-h-offset", bridge.getOverlayWindow().getHOffset());
      Lizzie.config.leelazConfig.put("foxgo-v-offset", bridge.getOverlayWindow().getVOffset());
      Lizzie.config.save();
      updateStatus("偏移已保存", new Color(0, 128, 0));
    } catch (Exception e) {
      updateStatus("偏移保存失败", Color.RED);
    }
  }

  private void loadConfig() {
    int tx = Lizzie.config.leelazConfig.optInt("foxgo-top-x", 0);
    int ty = Lizzie.config.leelazConfig.optInt("foxgo-top-y", 0);
    int bx = Lizzie.config.leelazConfig.optInt("foxgo-bottom-x", 0);
    int by = Lizzie.config.leelazConfig.optInt("foxgo-bottom-y", 0);

    if (tx > 0 && ty > 0 && bx > 0 && by > 0) {
      topXField.setText(String.valueOf(tx));
      topYField.setText(String.valueOf(ty));
      bottomXField.setText(String.valueOf(bx));
      bottomYField.setText(String.valueOf(by));
      updateStatus("配置已加载", new Color(0, 128, 0));
    }

    // 加载偏移设置（使用 setOffset 直接设置，而不是增量）
    int hOff = Lizzie.config.leelazConfig.optInt("foxgo-h-offset", 0);
    int vOff = Lizzie.config.leelazConfig.optInt("foxgo-v-offset", 0);
    bridge.getOverlayWindow().setOffset(hOff, vOff);
    if (hOff != 0 || vOff != 0) {
      updateStatus("偏移已加载", new Color(0, 128, 0));
    }
  }

  // ======================== Status helper ========================

  private void updateStatus(String text, Color color) {
    statusLabel.setText(text);
    statusLabel.setForeground(color);
  }
}
